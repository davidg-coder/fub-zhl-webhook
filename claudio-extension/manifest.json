{
  "manifest_version": 3,
  "name": "Claudio for Follow Up Boss",
  "short_name": "Claudio",
  "version": "0.2.5",
  "description": "Voice assistant inside Follow Up Boss for Power Real Estate Group agents. Ask for call lists, lead info, notes and more by talking.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://fub-zhl-webhook.netlify.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.followupboss.com/*"],
      "js": ["keyguard.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.followupboss.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["icons/claudio.png"], "matches": ["https://*.followupboss.com/*"] }
  ]
}
